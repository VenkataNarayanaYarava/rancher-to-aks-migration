    "namespace": "radiant-petclinic",
    "labels": {
      "app": "demo-db"
    },
    "annotations": {},
    "app_label": "demo-db",
    "replicas": 1,
    "container_images": [
      "postgres:18.3"
    ],
    "container_ports": [
      5432
    ],
    "resources": [
      {
        "requests": {
          "memory": "256Mi",
          "cpu": "100m"
        },
        "limits": {
          "memory": "512Mi",
          "cpu": "500m"
        }
      }
    ],
